# Provedor padrão: Command Code. O modelo recebe reasoning_effort "low", o piso
# do gateway; não existe valor para desligar o raciocínio lá.
AI_API_KEY=your-key-here
AI_BASE_URL=https://api.commandcode.ai/provider/v1
AI_MODEL=deepseek/deepseek-v4.1-flash
# Janela de inatividade por chamada, em ms (padrão 120000). Não é limite total:
# o relógio reinicia a cada trecho recebido.
MERCE_AI_TIMEOUT_MS=120000
# Teto de tokens por resposta (padrão 16000). Pedidos com várias operações
# gastam o orçamento em raciocínio; um teto baixo devolve JSON truncado.
MERCE_AI_MAX_TOKENS=16000
# Modo rápido (opcional): provedor/modelo alternativo para respostas velozes
AI_FAST_API_KEY=your-fast-key-here
AI_FAST_BASE_URL=https://api.cerebras.ai/v1
AI_FAST_MODEL=qwen-3.8-27b
# GPT-6 Luna, no mesmo gateway (AI_API_KEY/AI_BASE_URL), com raciocínio baixo.
# AI_LUNA_MODEL=gpt-6-luna
# AI_MIMO_MODEL=xiaomi/mimo-v2.6-flash
# Preço de tabela para o custo estimado: entrada,saída,entrada-em-cache em US$
# por milhão de tokens. Sem estas linhas valem os valores de lib/models.ts.
# MERCE_PRICE_DEEPSEEK=0.14,0.56,0.014
# MERCE_PRICE_LUNA=0.1,0.5,0.01
# MERCE_PRICE_MIMO=0.14,0.28,0.0028
# MERCE_PRICE_QWEN_FAST=0.6,1.2,0.6
