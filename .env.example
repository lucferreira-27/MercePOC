MERGE_GATEWAY_API_KEY=your-key-here
MERGE_GATEWAY_BASE_URL=https://api-gateway.merge.dev/v1
MERGE_GATEWAY_MODEL=zai/glm-5.3-flash
# Janela de inatividade por chamada, em ms (padrão 120000). Não é limite total:
# o relógio reinicia a cada trecho recebido.
MERCE_AI_TIMEOUT_MS=120000
# Teto de tokens por resposta (padrão 16000). Pedidos com várias operações
# gastam o orçamento em raciocínio; um teto baixo devolve JSON truncado.
MERCE_AI_MAX_TOKENS=16000
# Modo rápido (opcional): provedor/modelo alternativo para respostas velozes
FAST_GATEWAY_API_KEY=your-fast-key-here
FAST_GATEWAY_BASE_URL=https://api.cerebras.ai/v1
FAST_GATEWAY_MODEL=qwen-3.8-27b
