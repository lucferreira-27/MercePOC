  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/start.mjs",
    "cf:build": "vinext build --mode cloudflare",
    "cf:preview": "vinext build --mode cloudflare && wrangler dev --port 4311 --ip 127.0.0.1",
    "cf:deploy": "vinext build --mode cloudflare && wrangler deploy",
    "cf:secrets": "node scripts/cf-secrets.mjs",
    "cf:logs": "wrangler tail -c cloudflare/wrangler.jsonc",
    "lint": "oxlint app lib components/furniture-view.tsx components/turn-progress.tsx components/turn-activity.tsx components/model-picker.tsx components/usage-meter.tsx components/modular-editor.tsx components/finish-picker.tsx components/plan-thumb.tsx components/quote-panel.tsx components/cut-plan-panel.tsx components/cut-sheet-drawing.tsx components/parts-panel.tsx components/agent-steps.tsx components/room-panel.tsx components/command-palette.tsx components/template-gallery.tsx components/change-set.tsx components/move-pad.tsx components/branch-confirm.tsx components/print-sheet.tsx hooks/use-project-tools.ts hooks/use-event.ts hooks/use-delayed.ts tests scripts worker vite.config.ts",
    "format": "oxfmt",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "node scripts/modular-live.mjs",
    "demos": "tsx scripts/seed-demos.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/run.mjs",
    "bench:doc": "tsx bench/doc.mjs",
    "bench:router": "tsx bench/router.mjs",
    "bench:claims": "tsx bench/claims.mjs",
    "bench:askact": "tsx bench/askact.mjs",
